<Window x:Class="Generativa.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Generativa.Host"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Generativa" Height="800" Width="1200"
        Icon="app-icon.ico"
        Background="#0f1115">
    <Grid>
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />

        <StackPanel x:Name="StartupPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="480">
            <TextBlock Text="Generativa"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#f2f2f2"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16" />
            <TextBlock Text="Iniciando servicios locales..."
                       FontSize="14"
                       Foreground="#9aa0aa"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16" />
            <ItemsControl x:Name="StatusList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="#f2f2f2"
                                   FontSize="13"
                                   FontFamily="Consolas"
                                   Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>
